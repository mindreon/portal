# ============================================================
# Portal 内部业务系统 — 环境变量模板
# 复制为 .env 后按环境修改：cp .env.example .env
# ============================================================

# 对外访问地址（浏览器里打开的地址，不含末尾斜杠）
# 本地 docker compose 用 http://localhost
# 公司内网部署改成 http://portal.example.com 或 https://...
PUBLIC_URL=http://localhost

# Caddy 对外暴露的宿主机 HTTP 端口，默认 80
CADDY_HTTP_PORT=80

# FastAPI 会话签名密钥。生产环境必须换成足够长的随机字符串：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# 生产环境把 cookie 设为 Secure（仅 HTTPS）。本地 http 保持 false
COOKIE_SECURE=false

# 数据库。docker compose 会自动覆盖为容器内的 Postgres 地址
# 本地不用 Docker 时可用 SQLite：sqlite:///./portal.db
DATABASE_URL=postgresql+psycopg://portal:portal@db:5432/portal

# 允许开发登录（不走飞书）。公司正式环境务必设为 false
AUTH_ALLOW_DEV_LOGIN=true

# ------------------------------------------------------------
# 飞书企业自建应用（https://open.feishu.cn/app）
# 未填写 APP_ID 时，登录页只显示「开发登录」
# ------------------------------------------------------------
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 必须与飞书开放平台「安全设置 → 重定向 URL」完全一致
# docker 一键部署默认走 80 端口的反向代理
FEISHU_REDIRECT_URI=http://localhost/api/v1/auth/feishu/callback

# 空格分隔的授权 scope。需要 refresh_token 时加上 offline_access
# 必须先在飞书后台申请对应权限，否则用户授权会报 20027
FEISHU_SCOPES=auth:user.id:read

# 前端在开发模式代理到后端的地址（仅 npm run dev 使用）
API_INTERNAL_URL=http://localhost:8000

# 合同 PDF 上传目录（Docker 里用数据卷）
UPLOAD_DIR=./data/uploads

# ------------------------------------------------------------
# 合同理解：逐页调用通义千问，草稿信息齐了就停。
# 默认 qwen3.7-plus。电子页发文本，扫描页发缩小后的图。
# 北京：https://dashscope.aliyuncs.com/compatible-mode/v1
# 新加坡：https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# ------------------------------------------------------------
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_OCR_MODEL=qwen3.7-plus
